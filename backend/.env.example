# ============================================================
# 后端环境变量（复制为 backend/.env）
# ============================================================
# ⚠️ Prisma 读取的是 backend/.env，不是项目根目录的 .env
#    部署时务必确保本文件复制为 backend/.env
# ============================================================

# ---- 数据库 ----
# 宝塔 PostgreSQL 管理器创建的数据库
DATABASE_URL="postgresql://数据库用户名:数据库密码@127.0.0.1:5432/数据库名?schema=public"

# ---- JWT 认证 ----
# 生产环境务必替换为 32 位以上随机字符串
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="please-change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---- 服务端口 ----
BACKEND_PORT=3001
BACKEND_HOST=127.0.0.1

# ---- 前端地址（用于 CORS）----
# 生产环境填你的域名，开发环境填 http://localhost:3000
CORS_ORIGIN="https://qd.yqjxa.cn"

# ---- 发票 OCR 服务（可选，不使用可留空）----
# OCR_SERVICE_URL="http://127.0.0.1:8000"
# OCR_SERVICE_TIMEOUT_MS=30000
# PADDLEOCR_MODEL="PP-StructureV3"

# ---- 文件上传 ----
INVOICE_UPLOAD_DIR="./storage/invoices"
